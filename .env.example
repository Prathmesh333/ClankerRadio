# Local services bind to localhost. Keep this token out of browser code.
STUDIO_TOKEN=replace-with-a-long-local-secret
API_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///.data/clanker.db
ASSET_ROOT=.data/assets
QUEUE_BACKEND=local
STORAGE_BACKEND=local
# Codex competitions use the existing local Codex CLI login. These variables are optional.
# CODEX_EXECUTABLE=C:/path/to/codex.exe
# CODEX_MODEL=your-supported-codex-model
# CODEX_CALL_TIMEOUT=240
# Container overrides use PostgreSQL, Redis, and the shared local asset volume.
# Optional S3 storage requires AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# STORAGE_BACKEND=s3
# S3_BUCKET=clanker-radio
# S3_ENDPOINT_URL=http://127.0.0.1:9000
