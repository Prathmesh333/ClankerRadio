{
  "appId": "com.clankerradio.desktop",
  "productName": "Clanker Radio",
  "directories": {
    "app": "desktop",
    "output": "dist/desktop"
  },
  "files": [
    "*.cjs",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/desktop/web",
      "to": "web"
    },
    {
      "from": "build/desktop/web/node_modules",
      "to": "web/node_modules"
    },
    {
      "from": "build/desktop/api/clanker-api",
      "to": "api"
    },
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "build/desktop/adblock",
      "to": "adblock"
    },
    {
      "from": "apps/web/public/brand/clanker-radio.png",
      "to": "clanker-radio.png"
    }
  ],
  "win": {
    "target": "nsis",
    "artifactName": "Clanker-Radio-Setup-${version}.${ext}",
    "signExecutable": false,
    "icon": "desktop/assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": false,
  "electronLanguages": [
    "en-US",
    "hi"
  ]
}
